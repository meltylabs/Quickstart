{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biologix-decision-board",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/worker.js",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/ovo-labs",
      "/ovo-labs/*",
      "/ovo-labs-porcelain",
      "/ovo-labs-porcelain/*",
      "/datum-peptides",
      "/datum-peptides/*",
      "/third-standard",
      "/third-standard/*"
    ],
    "binding": "ASSETS"
  }
}
