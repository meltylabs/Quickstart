{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biologix-decision-board",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/worker.js",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "BIOLOGIX_ALLOW_BREAK_GLASS": "true",
    "BIOLOGIX_GATEWAY_KEY_ID": "primary-2026-07",
    "BIOLOGIX_OPERATOR_EMAIL_DOMAIN": "ovotalent.com",
    "BIOLOGIX_TRACKING_REDIRECT_HOSTS": "biologixlabsresearch.com,www.biologixlabsresearch.com",
    "BIOLOGIX_UPSTREAM_ORIGIN": "https://ovo.academy"
  },
  "ratelimits": [
    {
      "name": "BIOLOGIX_LOGIN_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/control-tower",
      "/control-tower/*",
      "/passport",
      "/passport/*",
      "/biologix",
      "/biologix/*",
      "/api/biologix",
      "/api/biologix/*",
      "/api/control-tower",
      "/api/control-tower/*",
      "/r/biologix",
      "/r/biologix/*",
      "/ovo-labs",
      "/ovo-labs/*",
      "/ovo-labs-porcelain",
      "/ovo-labs-porcelain/*",
      "/datum-peptides",
      "/datum-peptides/*",
      "/third-standard",
      "/third-standard/*"
    ],
    "binding": "ASSETS"
  }
}
