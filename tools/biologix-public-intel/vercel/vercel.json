{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sfo1"
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/observatory-cron",
      "schedule": "5 * * * *"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 300
    }
  }
}
